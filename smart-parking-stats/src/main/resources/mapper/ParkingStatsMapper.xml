<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartparking.stats.mapper.ParkingStatsMapper">

    <!-- 查询指定日期的统计数据 -->
    <select id="selectByDate" resultType="com.smartparking.stats.po.ParkingStats">
        SELECT *
        FROM parking_stats
        WHERE stat_date = #{date} AND is_deleted = 0
    </select>

    <!-- 查询日期范围内的总收入 -->
    <select id="sumIncomeByDateRange" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(total_income), 0)
        FROM parking_stats
        WHERE stat_date BETWEEN #{startDate} AND #{endDate} AND is_deleted = 0
    </select>

    <!--
      原「按小时统计入场数量」直查 parking_order（订单域 owns 表），违反服务边界。
      已改为调用 order 服务 /api/order/internal/entry-count-by-hour，见 getPeakHours()。
    -->
</mapper>
