{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(mvn *)",
      "Bash(bash scripts/run-tests.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-tests.sh"
          }
        ]
      }
    ]
  }
}
