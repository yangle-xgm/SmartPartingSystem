# ===== Maven / Java 构建产物 =====
target/
**/target/
*.class
*.jar
*.war
*.ear
!**/src/**/*.jar

# ===== 前端依赖与构建产物（web / h5 等） =====
node_modules/
**/node_modules/
dist/
**/dist/
.output/
.cache/

# ===== IDE / 工具 =====
.idea/
.mimocode/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ===== 日志 / 临时 =====
*.log
**/*.log
*.tmp
dumpstreams/
**/*.dumpstream

# ===== 智能体工作区（内部数据，不进版本库） =====
.workbuddy/

# ===== 解包文档（由 docx 解出的中间文件，可重建） =====
unpacked_doc/
unpacked_template/

# ===== 本地设备服务临时目录 =====
smart-parking-device-service-*/

# ===== 本地联调日志 =====
run-logs/
logs/

# ===== Playwright E2E 产物（可重建，不入库） =====
scripts/e2e/test-results/
scripts/e2e/playwright-report/
scripts/e2e/.tmp-results-*/
# Playwright 每次运行用的独立输出目录（--output=.tmp-xxx，避免 bulk-delete 守卫）
scripts/e2e/.tmp-*/

# ===== 运行时上传文件（用户头像等，不入库） =====
uploads/

# ===== 本地密钥/凭证（沙箱密钥、私钥等，绝对不入库） =====
secrets/

# ===== 本地环境变量（.env.example 是模板，需保留入库） =====
.env
.env.local
.env.*.local
!.env.example
